# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURATION PASSERELLES DE PAIEMENT AFRIQUE FRANCOPHONE (M.D.D.)
# ==============================================================================

# 1. CinetPay (Cameroun, CI, Sénégal, Bénin, Togo, RDC - Orange Money, MTN MoMo, Wave, Moov)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""
CINETPAY_MODE="SANDBOX" # Passer à "PRODUCTION" pour les encaissements réels

# 2. FedaPay (Bénin, Togo, Côte d'Ivoire, Sénégal - Moov, MTN, Carte Bancaire)
FEDAPAY_SECRET_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_ENVIRONMENT="sandbox" # ou "live"

# 3. Wave Checkout (Sénégal, Côte d'Ivoire)
WAVE_API_KEY=""
WAVE_BUSINESS_ID=""
WAVE_WEBHOOK_SECRET=""

# 4. Notch Pay (Cameroun - Orange Money, MTN Mobile Money)
NOTCHPAY_PUBLIC_KEY=""
NOTCHPAY_PRIVATE_KEY=""

# ==============================================================================
# BASE DE DONNÉES POSTGRESQL & NOTIFICATIONS
# ==============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/mdd_production"
WHATSAPP_BUSINESS_TOKEN=""
ADMIN_SECRET_KEY="super_secret_admin_key"
